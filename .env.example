# mcp-squared environment variables (names only; never commit real values).
# All variables are optional. Bun auto-loads .env files from the working
# directory, so a variable assigned an empty value here may not behave like an
# unset one; entries whose empty value differs from unset stay commented out.

# Path to a config file; takes precedence over project and user config discovery.
# Empty or missing paths fall through to normal discovery (see README "Configuration").
MCP_SQUARED_CONFIG=

# Optional shared secret for the daemon/proxy handshake (same as --daemon-secret).
# Empty or whitespace-only values disable the handshake.
MCP_SQUARED_DAEMON_SECRET=

# Agent Safety Kit (see docs/AGENT_SAFETY_KIT.md for defaults and semantics).
# AGENT_SAFETY_ENABLED=
# AGENT_POLICY_PATH=
# AGENT_POLICY_PLAYBOOK=
# AGENT_ENV=
# AGENT_POLICY_REPORT_ONLY=
# AGENT_OBS_SINK=
# OTEL_SERVICE_NAME=
