{
  "name": "mcp-squared",
  "version": "0.8.1",
  "description": "MCP² (Mercury Control Plane) - A local-first meta-server and proxy for the Model Context Protocol",
  "author": "aditzel",
  "license": "Apache-2.0",
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "bin": {
    "mcp-squared": "bin/mcp-squared"
  },
  "files": [
    "bin/mcp-squared",
    "dist/index.js",
    "dist/tui/*.js",
    "dist/*.scm",
    "dist/*.wasm"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts src/tui/config.ts src/tui/monitor.ts --outdir dist --target bun --packages=external",
    "build:compile": "bun build src/index.ts --compile --outfile dist/mcp-squared --external @opentui/core --external @opentui/core-darwin-arm64 --external @opentui/core-darwin-x64 --external @opentui/core-linux-arm64 --external @opentui/core-linux-x64 --external @opentui/core-win32-arm64 --external @opentui/core-win32-x64",
    "build:compile:matrix": "bash scripts/compile-matrix.sh",
    "prepack": "bun run build && bun run build:verify",
    "audit": "bun audit --ignore=GHSA-26pp-8wgv-hjvm --ignore=GHSA-27v5-c462-wpq7 --ignore=GHSA-2gcr-mfcq-wcc3 --ignore=GHSA-2pr8-phx7-x9h3 --ignore=GHSA-3hrh-pfw6-9m5x --ignore=GHSA-458j-xx4x-4375 --ignore=GHSA-5v7r-6r5c-r473 --ignore=GHSA-66ff-xgx4-vchm --ignore=GHSA-685m-2w69-288q --ignore=GHSA-69xw-7hcm-h432 --ignore=GHSA-75px-5xx7-5xc7 --ignore=GHSA-92pp-h63x-v22m --ignore=GHSA-9vqf-7f2p-gf9v --ignore=GHSA-f577-qrjj-4474 --ignore=GHSA-fx83-v9x8-x52w --ignore=GHSA-hm8q-7f3q-5f36 --ignore=GHSA-j3q9-mxjg-w52f --ignore=GHSA-jggg-4jg4-v7c6 --ignore=GHSA-jvwf-75h9-cwgg --ignore=GHSA-p77w-8qqv-26rm --ignore=GHSA-q3j6-qgpj-74h6 --ignore=GHSA-q6x5-8v7m-xcrf --ignore=GHSA-q8mj-m7cp-5q26 --ignore=GHSA-qp7p-654g-cw7p --ignore=GHSA-r5rp-j6wh-rvv4 --ignore=GHSA-v2v4-37r5-5v8g --ignore=GHSA-v39h-62p7-jpjc --ignore=GHSA-wmmm-f939-6g9c --ignore=GHSA-xf4j-xp2r-rqqx --ignore=GHSA-xpcf-pg52-r92g --ignore=GHSA-xq3m-2v4x-88gg --ignore=GHSA-xrhx-7g5j-rcj5",
    "test": "bun test",
    "test:fast": "SKIP_SLOW_TESTS=true bun test",
    "test:watch": "bun test --watch",
    "coverage:check": "bun run scripts/check-line-coverage.ts coverage/coverage-summary.txt coverage/lcov.info 80",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts AGENTS.md CLAUDE.md WARP.md README.md CHANGELOG.md package.json biome.json tsconfig.json",
    "release:check": "bun run audit && bun test && bun run build && bun run build:verify && bun run lint && bun run typecheck && bun pm pack --dry-run",
    "build:verify": "bun run scripts/verify-dist-runtime-imports.ts",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "rm -rf dist",
    "safety:sim": "bun run agent_safety_kit/cost_model/simulate.ts --tasks agent_safety_kit/cost_model/tasks.csv --pricing agent_safety_kit/cost_model/pricing.csv --out agent_safety_kit/cost_model/report.md",
    "eval:routing": "bun run scripts/eval-tool-routing.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/bun": "^1.3.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "tools",
    "proxy",
    "meta-server"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aditzel/mcp-squared"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@opentui/core": "^0.1.87",
    "hono": "^4.12.25",
    "smol-toml": "^1.6.1",
    "tar": "^7.5.11",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^1.30.1"
  },
  "overrides": {
    "@hono/node-server": "^1.19.11",
    "ajv": "^8.18.0",
    "diff": "8.0.3",
    "express-rate-limit": "8.2.2",
    "hono": "^4.12.7",
    "qs": "6.15.0",
    "tar": "^7.5.11"
  }
}
